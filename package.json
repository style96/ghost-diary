{
  "name": "ghost-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode recorded --host 127.0.0.1 --port 4174 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode recorded --outDir out",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "record:demo": "tsx scripts/record-demo.ts",
    "record:voices": "node --env-file=.env.local --import tsx scripts/record-elevenlabs.ts",
    "record:voices:dry": "tsx scripts/record-elevenlabs.ts --dry-run"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
